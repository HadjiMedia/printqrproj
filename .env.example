# PrintDrop Smart Printing Service — Environment Configuration

# Required for persistent order storage in production (use your PostgreSQL/Neon connection string).
# Add this in Vercel Project Settings > Environment Variables for Production, then redeploy.
# Do not commit a real connection string or database password.
DATABASE_URL=""

# Optional alternate names also supported when DATABASE_URL is not set:
# POSTGRES_URL="", POSTGRES_URL_NON_POOLING="", DATABASE_URL_UNPOOLED="", NEON_DATABASE_URL=""

# APP_URL: The public URL where this applet is hosted (used for shop QR codes and staff links)
APP_URL="https://ais-dev-uxteava5bwl4dpn7pynrlx-725551138946.asia-east1.run.app"

# Telegram Bot Integration
# 1. Obtain TELEGRAM_BOT_TOKEN by creating a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""

# 2. Add your bot as Admin to your private staff printing channel or group, and set the chat ID
# (Usually starts with a minus sign like -1001234567890)
TELEGRAM_CHAT_ID=""

# Admin & Staff Authentication
# Password required to log into the staff queue dashboard
ADMIN_PASSWORD="printdrop2025"

# Server Port
PORT=3000

# Node Environment
NODE_ENV="development"
